# =========================================================
# ORCA — Environment Configuration
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. Server-only secrets must never be
# prefixed with NEXT_PUBLIC_.
# =========================================================

# ---------------------------------------------------------
# Supabase (Phase 1 — required)
# Project Settings -> API in your Supabase dashboard.
# ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used for running SQL migrations
# (Supabase Settings -> Database -> Connection string -> URI).
DATABASE_URL=

# ---------------------------------------------------------
# App (Phase 1 — required)
# ---------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------
# Blockchain data providers (Phase 2 — required before Token/Wallet
# Scanner, Radar, Risk Score, Whale Detection, Smart Money work).
# Not required to run Phase 1, but the diagnostics page will report
# them as "not configured" until set.
# ---------------------------------------------------------
ALCHEMY_API_KEY=
MORALIS_API_KEY=
# Optional, used for supplemental contract/source data.
ETHERSCAN_API_KEY=

# ---------------------------------------------------------
# Telegram alerts (Phase 11 — not required until then)
# ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------
# Oceanus ecosystem (future — $OCS holder verification)
# Only set once the real, verified $OCS contract address is known.
# ---------------------------------------------------------
OCS_CONTRACT_ADDRESS=

# ---------------------------------------------------------
# Billing (future — Stripe). Architecture is prepared for this in
# later phases; leave unset until Stripe is actually wired up.
# ---------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
