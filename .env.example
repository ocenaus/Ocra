# =========================================================
# ORCA Bubble Map — Environment Configuration
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. Server-only secrets must never be
# prefixed with NEXT_PUBLIC_.
# =========================================================

# ---------------------------------------------------------
# Blockchain data providers (required for the bubble map to
# show real data). Without these, the app still runs — every
# panel just shows an honest "not configured" state instead
# of fake data.
# ---------------------------------------------------------
# Metadata + price supplement (alchemy_getTokenMetadata, Prices API,
# and the owner() on-chain read used for ownership/renouncement).
ALCHEMY_API_KEY=
# Primary source for token metadata, price, and — critically — top
# token holders (Moralis is the only provider we use with a general
# "get token owners" endpoint).
MORALIS_API_KEY=
# Contract source verification + capability heuristics (mint/burn/
# pause/blacklist) and total supply.
ETHERSCAN_API_KEY=
# CEX (Binance, KuCoin, MEXC, ...) 24h volume for the volume-currents
# visualization, via CoinGecko's ticker data. Free Demo API key. Optional —
# degrades to DEX-only volume when unset.
COINGECKO_API_KEY=

# ---------------------------------------------------------
# App
# ---------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------
# Supabase — optional for V1. The bubble map requires no
# authentication and no database; these are only needed if
# you want the (currently unused) auth pages and admin
# diagnostics page to work.
# ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ---------------------------------------------------------
# Not used in the current scope — kept for a possible future
# return to the full multi-phase ORCA plan.
# ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=
OCS_CONTRACT_ADDRESS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
